# FeltDB configuration used by the Rust runtime bridge
VITE_FELTDB_MODE=local
VITE_FELTDB_NAMESPACE=stream
VITE_FELTDB_ENVIRONMENT=development
VITE_FELTDB_URL=http://localhost:7700
VITE_FELTDB_TOKEN=
VITE_FELTDB_API_KEY=
VITE_FELTDB_MANAGED_URL=
VITE_FELTDB_MANAGED_APPLICATION_ID=
VITE_FELTDB_APPLICATION_ID=
FELTDB_MANAGED_CONTROL_API_KEY=
FELTDB_TOKEN=

# Stream Rust runtime configuration
STREAM_FELTDB_PATH=.feltdb-data/stream
STREAM_NODE_BINARY=node
NODE_ENV=development
